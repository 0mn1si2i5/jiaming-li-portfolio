---
import Localized from './Localized.astro';

interface LocalizedText { en: string; zh: string }
interface Group { owner: LocalizedText; items: LocalizedText[]; emphasis?: boolean }
interface Props { title: LocalizedText; groups: Group[]; note?: LocalizedText }

const { title, groups, note } = Astro.props;
---

<figure class="responsibility-map">
  <figcaption><Localized {...title} /></figcaption>
  <div class="groups">
    {groups.map((group) => (
      <div class:list={['group', { emphasis: group.emphasis }]}>
        <span class="group-owner"><Localized {...group.owner} /></span>
        <ul>
          {group.items.map((item) => <li><Localized {...item} /></li>)}
        </ul>
      </div>
    ))}
  </div>
  {note && <p class="map-note"><Localized {...note} /></p>}
</figure>

<style>
  .responsibility-map { margin: 0 0 3.3rem; }
  .responsibility-map figcaption { margin-bottom: 1.25rem; color: var(--ink); font-family: var(--font-editorial); font-weight: 500; font-size: 1.15rem; }
  .groups { display: grid; gap: .8rem; }
  .group { padding: 1rem 1.25rem; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; }
  .group.emphasis { border-color: color-mix(in srgb, var(--ink) 34%, var(--line)); border-left-width: 3px; }
  .group-owner { display: block; margin-bottom: .55rem; color: var(--ink); font-weight: 650; font-size: .9rem; }
  .group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem .9rem; }
  .group li { color: var(--muted); font-size: .88rem; line-height: 1.5; }
  .group.emphasis li { color: var(--ink); }
  .map-note { margin: 1rem 0 0; color: var(--muted); font-size: .88rem; }
</style>
