---
import Localized from './Localized.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<section class="product-story" aria-labelledby="omnipet-story-title">
  <header>
    <div class="intro-meta">
      <p class="eyebrow"><Localized en="Engine overview" zh="引擎总览" /></p>
      <span><Localized en="Open-source Alpha" zh="开源 Alpha" /></span>
    </div>
    <h2 id="omnipet-story-title"><Localized en="From uncertain image to bounded release." zh="从不确定图像到有边界的发布。" /></h2>
    <p><Localized en="The open-source sprite v2 engine keeps failures visible, pauses for explicit review, and resumes through bounded actions." zh="开源 sprite v2 引擎保留失败结果、等待明确审查，并通过有界动作继续推进。" /></p>
  </header>

  <ol class="engine-flow">
    <li>
      <span>01</span>
      <h3><Localized en="Describe in the manifest" zh="在清单中描述" /></h3>
      <p><Localized en="The project manifest defines pet identity, sprite requirements, and release inputs." zh="项目清单声明桌宠身份、精灵要求与发布输入。" /></p>
    </li>
    <li>
      <span>02</span>
      <h3><Localized en="Follow actions and validate" zh="遵循动作并验证" /></h3>
      <p><Localized en="A versioned action contract binds available next actions to the current run revision; project and package checks run before release." zh="带版本的动作契约将可用的下一步绑定到当前运行修订；发布前先检查项目与安装包。" /></p>
    </li>
    <li>
      <span>03</span>
      <h3><Localized en="Export, verify, and publish" zh="导出、验证并发布" /></h3>
      <p><Localized en="Export and independently verify the public bundle before publishing it to the catalog." zh="导出并独立验证公开包，再发布到公共目录。" /></p>
    </li>
  </ol>
  <p class="provider-boundary"><Localized en="Alpha currently supports one allowlisted built-in image provider; arbitrary provider, endpoint, or model configuration is not exposed." zh="Alpha 当前仅支持一个白名单内置图像 provider；不开放任意 provider、端点或模型配置。" /></p>

  <section class="outcome" aria-labelledby="omnipet-outcome-title">
    <div class="outcome-copy">
      <p class="eyebrow"><Localized en="Public result" zh="公开结果" /></p>
      <h3 id="omnipet-outcome-title"><Localized en="SuShi leaves as a pet, not a production archive." zh="SuShi 以桌宠而非生产档案的形式离开流程。" /></h3>
      <p><Localized en="The public catalog contains an installable release, documentation, and an asset license that can be checked without production access." zh="公共目录包含可安装发布、说明与资产许可，无需生产权限即可检查。" /></p>
      <p id="omnipet-release-label" class="sr-only"><Localized en="Public release properties" zh="公开发布属性" /></p>
      <div class="release-tags" aria-labelledby="omnipet-release-label">
        <span><Localized en="Installable" zh="可安装" /></span>
        <span><Localized en="Licensed" zh="有许可" /></span>
        <span><Localized en="Verifiable" zh="可验证" /></span>
      </div>
    </div>
    <div class="result-visuals">
      <figure>
        <img src={asset('/media/omnipet/sushi-preview.webp')} alt="SuShi, the public installable desktop pet produced through OmniPet." data-alt-en="SuShi, the public installable desktop pet produced through OmniPet." data-alt-zh="通过 OmniPet 生产并公开发布的可安装桌宠 SuShi。" loading="lazy" />
        <figcaption><strong>SuShi</strong><span><Localized en="Public catalog · v1.0.1" zh="公共目录 · v1.0.1" /></span></figcaption>
      </figure>
    </div>
  </section>
</section>

<style>
  .product-story {
    --paper: #181513;
    --ink: #f4eee7;
    --muted: #b8aaa0;
    --line: #4c403a;
    --signal: #f08b6f;
    box-sizing: border-box;
    width: 100%;
    margin: 5rem 0;
    padding: clamp(1.5rem, 6vw, 4rem);
    overflow: clip;
    color: var(--ink);
    background: linear-gradient(135deg, color-mix(in srgb, var(--signal) 5%, transparent), transparent 38%), var(--paper);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 3vw, 1.75rem);
  }
  header { max-width: 860px; }
  .intro-meta { display: flex; gap: 1rem; align-items: center; justify-content: space-between; }
  .intro-meta > span { padding: .4rem .65rem; color: var(--signal); font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border: 1px solid var(--signal); border-radius: 999px; }
  .eyebrow { margin: 0; color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h2, h3 { color: var(--ink); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
  h2 { margin: 1rem 0 1.25rem; font-size: clamp(2.5rem, 6vw, 5rem); }
  header > p:last-child, .outcome-copy > p { max-width: 700px; color: var(--muted); line-height: 1.65; }
  .engine-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: clamp(3rem, 7vw, 6rem) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .engine-flow li { position: relative; padding: 1.4rem clamp(1rem, 2.5vw, 2rem) 1.8rem 0; border-bottom: 1px solid var(--line); }
  .engine-flow li:not(:last-child) { margin-right: clamp(1rem, 2.5vw, 2rem); border-right: 1px solid var(--line); }
  .engine-flow li:not(:last-child)::after { content: '→'; position: absolute; top: 50%; right: -.55rem; color: var(--signal); }
  .engine-flow li > span { color: var(--signal); font-size: .68rem; letter-spacing: .1em; }
  .engine-flow h3 { margin: 2rem 0 .6rem; font-size: 1.25rem; letter-spacing: -.02em; }
  .engine-flow p { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.55; }
  .provider-boundary { max-width: 760px; margin: 1.25rem 0 0; color: var(--muted); font-size: .82rem; line-height: 1.6; }
  .outcome { display: grid; grid-template-columns: minmax(16rem, .72fr) minmax(0, 1.28fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; margin-top: clamp(4rem, 9vw, 8rem); }
  .outcome h3 { margin: .8rem 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); }
  .release-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .release-tags span { padding: .45rem .65rem; color: var(--signal); font-size: .65rem; font-weight: 700; text-transform: uppercase; border: 1px solid var(--line); }
  .result-visuals { min-width: 0; }
  figure { min-width: 0; margin: 0; }
  figure img { display: block; width: 100%; border: 1px solid var(--line); background: #0c0a09; }
  figure > img { aspect-ratio: 1; object-fit: cover; }
  figcaption { display: grid; gap: .2rem; padding: .8rem 0; border-bottom: 1px solid var(--line); }
  figcaption strong { color: var(--ink); font-size: .82rem; }
  figcaption span { color: var(--muted); font-size: .68rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 1024px) {
    .engine-flow, .outcome { grid-template-columns: 1fr; }
    .engine-flow li:not(:last-child) { margin-right: 0; border-right: 0; }
    .engine-flow li:not(:last-child)::after { content: '↓'; top: auto; right: .2rem; bottom: -.65rem; }
  }
  @media (max-width: 760px) {
    .product-story { margin: 4rem 0; }
  }
</style>
