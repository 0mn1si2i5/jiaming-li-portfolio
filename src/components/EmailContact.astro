---
import Localized from './Localized.astro';

interface Props {
  id: string;
  label: { en: string; zh: string };
  address: string;
}

const { id, label, address } = Astro.props;
const copyAriaEn = `Copy ${label.en.toLowerCase()}`;
const copyAriaZh = `复制${label.zh}`;
---

<div class="email-contact" data-copy-email data-address={address}>
  <span class="email-label"><Localized {...label} /></span>
  <a class="email-address" href={`mailto:${address}`}>{address}</a>
  <button type="button" class="copy-button">
    <span aria-hidden="true"><Localized en="Copy" zh="复制" /></span>
    <span class="sr-only"><Localized en={copyAriaEn} zh={copyAriaZh} /></span>
  </button>
  <span class="email-status" id={`email-status-${id}`} role="status" aria-live="polite"></span>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '.email-contact .copy-button',
  );

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const contact = button.closest<HTMLElement>('[data-copy-email]');
      const address = contact?.dataset.address ?? '';
      const status = contact?.querySelector<HTMLElement>('.email-status');
      if (!address || !status) return;

      const locale = document.documentElement.dataset.locale === 'zh' ? 'zh' : 'en';
      const copied = locale === 'zh' ? '已复制' : 'Copied';
      const failed =
        locale === 'zh'
          ? '请选中邮箱地址手动复制。'
          : 'Select and copy the address manually.';

      try {
        if (!navigator.clipboard?.writeText) {
          throw new Error('clipboard unavailable');
        }
        await navigator.clipboard.writeText(address);
        status.textContent = copied;
      } catch {
        status.textContent = failed;
      }
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .email-contact {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .65rem;
  }
  .email-label {
    color: var(--muted);
    font-size: .78rem;
    font-weight: 650;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .email-address {
    color: var(--ink);
    text-decoration: none;
  }
  .email-address:hover,
  .email-address:focus-visible {
    text-decoration: underline;
  }
  .copy-button {
    min-height: 44px;
    padding: .45rem .8rem;
    cursor: pointer;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 100px;
    font: inherit;
    font-size: .8rem;
    font-weight: 650;
    letter-spacing: .04em;
  }
  .copy-button:hover {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }
  .email-status {
    color: var(--muted);
    font-size: .85rem;
  }
</style>
