---
import Localized from './Localized.astro';

const modes = [
  { index: '01', title: { en: 'Other Side', zh: '地球另一端' }, detail: { en: 'Spherical relationships', zh: '球面空间关系' } },
  { index: '02', title: { en: 'Development, Unpacked', zh: '发展的不同侧面' }, detail: { en: 'Human evidence layers', zh: '人类发展证据层' } },
  { index: '03', title: { en: 'Sunline', zh: '日照线' }, detail: { en: 'Time and sunlight', zh: '时间与日照变化' } },
];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<section class="product-story" aria-labelledby="mundus-story-title">
  <header>
    <p class="eyebrow"><Localized en="Product overview" zh="产品总览" /></p>
    <h2 id="mundus-story-title"><Localized en="One world. Three useful ways to look." zh="同一个世界，三种有用的观察方式。" /></h2>
    <p><Localized en="The modes are distinct products for visitors, but extensions of the same platform underneath." zh="对访客而言，它们是用途不同的产品；在系统内部，它们是同一平台上的扩展。" /></p>
  </header>

  <figure class="overview-visual">
    <img
      src={asset('/media/mundus/modes-overview.webp')}
      alt="Mundus overview combining its three public observation modes."
      data-alt-en="Mundus overview combining its three public observation modes."
      data-alt-zh="Mundus 三种公开观察模式的产品总览。"
      loading="lazy"
    />
    <figcaption>
      {modes.map((mode) => (
        <span><small>{mode.index}</small><strong><Localized {...mode.title} /></strong><em><Localized {...mode.detail} /></em></span>
      ))}
    </figcaption>
  </figure>

  <div class="platform-moment">
    <div class="platform-copy">
      <p class="eyebrow"><Localized en="Shared platform" zh="共享平台" /></p>
      <h3><Localized en="Add a lens, not another globe." zh="增加一种观察方式，而不是再造一个地球。" /></h3>
      <p><Localized en="A versioned registered mode brings its own state, data, and explanation while reusing navigation, geographic selection, shareable URLs, provenance, validation, and rendering fallbacks." zh="带版本的注册模式带来自己的状态、数据和解释，同时复用导航、地理选择、可分享链接、来源记录、验证与渲染回退。" /></p>
      <p id="mundus-extension-label" class="sr-only"><Localized en="Mundus extension contract" zh="Mundus 扩展契约" /></p>
      <ol aria-labelledby="mundus-extension-label">
        <li><Localized en="Declare the question" zh="声明观察问题" /></li>
        <li><Localized en="Connect evidence" zh="连接数据证据" /></li>
        <li><Localized en="Reuse and share" zh="复用并分享" /></li>
      </ol>
      <p><Localized en="Dataset scope, cartographic boundaries, and solar approximations remain visible product limits." zh="数据集范围、制图边界与太阳近似始终作为明确的产品限制呈现。" /></p>
    </div>
  </div>
</section>

<style>
  .product-story {
    --paper: #151917;
    --ink: #f1eee6;
    --muted: #a8b0aa;
    --line: #414843;
    --signal: #8ec8d7;
    box-sizing: border-box;
    width: 100%;
    margin: 5rem 0;
    padding: clamp(1.5rem, 6vw, 4rem);
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 3vw, 1.75rem);
  }
  header { max-width: 800px; }
  .eyebrow { margin: 0; color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h2, h3 { color: var(--ink); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
  h2 { margin: 1rem 0 1.25rem; font-size: clamp(2.5rem, 6vw, 5rem); }
  h3 { margin: .8rem 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); }
  header > p:last-child, .platform-copy > p { color: var(--muted); line-height: 1.65; }
  .overview-visual { margin: clamp(2.5rem, 6vw, 5rem) 0 0; }
  .overview-visual img, .platform-moment img { display: block; width: 100%; object-fit: cover; border: 1px solid var(--line); background: #090b0a; }
  .overview-visual img { aspect-ratio: 4 / 3; }
  .overview-visual figcaption { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
  .overview-visual figcaption > span { display: grid; gap: .25rem; padding: 1rem; border-right: 1px solid var(--line); }
  .overview-visual figcaption > span:last-child { border-right: 0; }
  small { color: var(--signal); font-size: .65rem; letter-spacing: .1em; }
  strong { color: var(--ink); font-size: .9rem; }
  em { color: var(--muted); font-size: .72rem; font-style: normal; }
  .platform-moment { max-width: 760px; margin-top: clamp(4rem, 9vw, 8rem); }
  .platform-copy ol { display: grid; gap: .7rem; margin: 1.5rem 0 0; padding: 0; list-style: none; counter-reset: step; }
  .platform-copy li { display: grid; grid-template-columns: 2rem 1fr; align-items: baseline; padding-top: .7rem; color: var(--ink); border-top: 1px solid var(--line); counter-increment: step; }
  .platform-copy li::before { content: '0' counter(step); color: var(--signal); font-size: .68rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 1024px) {
    .overview-visual figcaption, .platform-moment { grid-template-columns: 1fr; }
    .overview-visual figcaption > span { border-right: 0; border-bottom: 1px solid var(--line); }
    .overview-visual figcaption > span:last-child { border-bottom: 0; }
  }
  @media (max-width: 760px) {
    .product-story { margin: 4rem 0; }
  }
</style>
