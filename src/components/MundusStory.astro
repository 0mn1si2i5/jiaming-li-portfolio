---
import Localized from './Localized.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;

const modes = [
  {
    id: 'antipodes',
    number: '01',
    title: { en: 'Other Side', zh: '地球另一端' },
    description: { en: 'Spherical relationships', zh: '球面空间关系' },
    image: '/media/mundus/other-side-detail.webp',
    alt: {
      en: 'The Mundus Other Side mode showing the through-Earth relationship between two endpoints.',
      zh: 'Mundus“地球另一端”模式，展示穿过地球的两端空间关系。',
    },
    href: 'https://0mn1si2i5.github.io/Mundus/?mode=antipodes&v=1',
  },
  {
    id: 'development',
    number: '02',
    title: { en: 'Development, Unpacked', zh: '发展的不同侧面' },
    description: { en: 'Development structure over time', zh: '发展结构与时间变化' },
    image: '/media/mundus/development.webp',
    alt: {
      en: 'The Mundus Development mode comparing published development indicators on the globe.',
      zh: 'Mundus“发展的不同侧面”模式，在地球上比较已发布的发展指标。',
    },
    href: 'https://0mn1si2i5.github.io/Mundus/?mode=development&indicator=hdi&year=2023&v=1',
  },
  {
    id: 'sunline',
    number: '03',
    title: { en: 'Sunline', zh: '日照线' },
    description: { en: 'Time and sunlight', zh: '时间与日照变化' },
    image: '/media/mundus/sunline.webp',
    alt: {
      en: 'The Mundus Sunline mode showing sunlight and the day-night boundary on the globe.',
      zh: 'Mundus“日照线”模式，展示地球上的日照与昼夜边界。',
    },
    href: 'https://0mn1si2i5.github.io/Mundus/?mode=sunline&v=1',
  },
] as const;

const defaultMode = modes[0];
---

<section class="product-story mundus-preview" aria-labelledby="mundus-story-title">
  <header>
    <p class="eyebrow">
      <Localized en="Parchment Atlas · Preview" zh="Parchment Atlas · 预览" />
    </p>
    <h2 id="mundus-story-title">
      <Localized en="Three views of the same globe." zh="同一颗地球上的三种观察方式。" />
    </h2>
    <p>
      <Localized
        en="Choose a mode to compare the current public views. Open the image to continue in Mundus."
        zh="选择模式比较当前公开界面；点击图片可前往 Mundus 继续操作。"
      />
    </p>
  </header>

  <figure class="overview-visual">
    <span id="mundus-preview-new-tab-label" class="sr-only">
      <Localized
        en="Open this Mundus mode in a new tab."
        zh="在新标签页打开这个 Mundus 模式。"
      />
    </span>
    <div
      id="mundus-preview-panel"
      role="tabpanel"
      aria-labelledby="mundus-preview-antipodes"
    >
      <a
        class="preview-link"
        href={defaultMode.href}
        target="_blank"
        rel="noopener noreferrer"
        data-preview-link
        aria-labelledby="mundus-preview-antipodes mundus-preview-new-tab-label"
      >
        <img
          src={asset(defaultMode.image)}
          alt={defaultMode.alt.en}
          data-preview-image
          loading="lazy"
        />
        <span class="preview-action" aria-hidden="true">
          <Localized en="Open mode ↗" zh="打开模式 ↗" />
        </span>
      </a>
    </div>
    <figcaption role="tablist" aria-label="Mundus mode preview">
      {modes.map((mode, index) => (
        <button
          type="button"
          role="tab"
          id={`mundus-preview-${mode.id}`}
          aria-controls="mundus-preview-panel"
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-preview-tab
          data-mode-id={mode.id}
          data-src={asset(mode.image)}
          data-href={mode.href}
          data-alt-en={mode.alt.en}
          data-alt-zh={mode.alt.zh}
        >
          <small>{mode.number}</small>
          <strong><Localized {...mode.title} /></strong>
          <em><Localized {...mode.description} /></em>
        </button>
      ))}
    </figcaption>
  </figure>
</section>

<script>
  const preview = document.querySelector<HTMLElement>('.mundus-preview');

  if (preview) {
    const tabs = [
      ...preview.querySelectorAll<HTMLButtonElement>('[data-preview-tab]'),
    ];
    const panel = preview.querySelector<HTMLElement>('#mundus-preview-panel');
    const link = preview.querySelector<HTMLAnchorElement>('[data-preview-link]');
    const image = preview.querySelector<HTMLImageElement>('[data-preview-image]');
    let requestId = 0;

    const localeSuffix = () =>
      document.documentElement.dataset.locale === 'zh' ? 'Zh' : 'En';

    const syncLocale = (tab: HTMLButtonElement) => {
      if (!image) return;
      const suffix = localeSuffix();
      image.alt = tab.dataset[`alt${suffix}`] ?? '';
    };

    const activate = (tab: HTMLButtonElement) => {
      if (!panel || !link || !image || !tabs.includes(tab)) return;
      const src = tab.dataset.src;
      const href = tab.dataset.href;
      if (!src || !href) return;

      const currentRequest = ++requestId;
      const candidate = new Image();
      candidate.onload = () => {
        if (currentRequest !== requestId) return;
        image.src = src;
        link.href = href;
        tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
        });
        panel.setAttribute('aria-labelledby', tab.id);
        link.setAttribute(
          'aria-labelledby',
          `${tab.id} mundus-preview-new-tab-label`,
        );
        syncLocale(tab);
      };
      candidate.onerror = () => {
        if (
          currentRequest !== requestId ||
          document.activeElement !== tab
        ) return;
        const selected = tabs.find(
          (item) => item.getAttribute('aria-selected') === 'true',
        );
        if (selected) selected.focus();
      };
      candidate.src = src;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const offsets: Record<string, number> = {
          ArrowLeft: -1,
          ArrowUp: -1,
          ArrowRight: 1,
          ArrowDown: 1,
        };
        let next = index;
        if (event.key in offsets) {
          next = (index + offsets[event.key] + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          next = 0;
        } else if (event.key === 'End') {
          next = tabs.length - 1;
        } else {
          return;
        }
        event.preventDefault();
        tabs[next].focus();
        activate(tabs[next]);
      });
    });

    new MutationObserver(() => {
      const selected = tabs.find(
        (tab) => tab.getAttribute('aria-selected') === 'true',
      );
      if (selected) syncLocale(selected);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-locale'],
    });

    syncLocale(tabs[0]);
  }
</script>

<style>
  .product-story {
    --paper: #151917;
    --ink: #f1eee6;
    --muted: #a8b0aa;
    --line: #414843;
    --signal: #8ec8d7;
    box-sizing: border-box;
    width: 100%;
    margin: 5rem 0;
    padding: clamp(1.5rem, 6vw, 4rem);
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 3vw, 1.75rem);
  }
  header { max-width: 800px; }
  .eyebrow { margin: 0; color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h2 { color: var(--ink); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
  h2 { margin: 1rem 0 1.25rem; font-size: clamp(2.5rem, 6vw, 5rem); }
  header > p:last-child { color: var(--muted); line-height: 1.65; }
  .overview-visual { margin: clamp(2.5rem, 6vw, 5rem) 0 0; }
  .preview-link { position: relative; display: block; overflow: hidden; border: 1px solid var(--line); background: #090b0a; }
  .preview-link img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; opacity: 1; transition: opacity 160ms ease; }
  .preview-action { position: absolute; right: 1rem; bottom: 1rem; padding: .45rem .7rem; color: var(--ink); background: rgb(9 11 10 / .82); border: 1px solid var(--line); border-radius: 999px; font-size: .7rem; }
  .overview-visual figcaption { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; margin-top: .5rem; }
  [data-preview-tab] { display: grid; gap: .25rem; min-height: 4.75rem; padding: 1rem; color: var(--muted); text-align: left; cursor: pointer; background: transparent; border: 1px solid var(--line); font: inherit; }
  [data-preview-tab][aria-selected='true'] { color: var(--ink); background: rgb(142 200 215 / .09); border-color: var(--signal); box-shadow: inset 0 2px 0 var(--signal); }
  [data-preview-tab]:focus-visible, .preview-link:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
  small { color: var(--signal); font-size: .65rem; letter-spacing: .1em; }
  strong { color: var(--ink); font-size: .9rem; }
  em { color: var(--muted); font-size: .72rem; font-style: normal; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .product-story { margin: 4rem 0; }
    .overview-visual figcaption { grid-template-columns: 1fr; }
    [data-preview-tab] { grid-template-columns: 2rem 1fr; align-items: center; min-height: 44px; }
    [data-preview-tab] em { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .preview-link img { transition: none; }
  }
  :global(.chronorbis-vision) {
    box-sizing: border-box;
    width: 100%;
    margin: clamp(4rem, 9vw, 8rem) 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: #28251f;
    background: #ece3ce;
    border: 1px solid #c8b994;
    border-radius: 14px;
  }
  :global(.chronorbis-status) {
    color: #725632;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  :global(.chronorbis-structure) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin-top: 2rem;
  }
  :global(.chronorbis-structure span) {
    padding: .85rem 1rem;
    color: #4f493d;
    background: rgb(255 255 255 / .28);
    border-left: 2px solid #8d6d3f;
  }
  @media (max-width: 560px) {
    :global(.chronorbis-vision) {
      padding: 1rem;
    }
    :global(.chronorbis-structure) {
      grid-template-columns: 1fr;
    }
  }
</style>
