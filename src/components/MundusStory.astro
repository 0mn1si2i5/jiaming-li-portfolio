---
import Localized from './Localized.astro';
import { site } from '../config/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;

// Mundus publishes one screenshot per primary mode with each deploy. The
// committed image is only shown until that manifest loads, or if it fails.
const manifestUrl = new URL('previews/manifest.json', site.links.mundusWebsite).href;
const fallback = {
  image: '/media/mundus/other-side-detail.webp',
  alt: {
    en: 'A Mundus screenshot showing the globe and a location result.',
    zh: 'Mundus 截图，显示地球和一个地点结果。',
  },
};
---

<section class="product-story mundus-preview" aria-labelledby="mundus-story-title">
  <header>
    <p class="eyebrow">
      <Localized en="Preview" zh="预览" />
    </p>
    <h2 id="mundus-story-title">
      <Localized en="Main modes on the live site." zh="线上的主要模式。" />
    </h2>
    <p>
      <Localized
        en="These screenshots are loaded from the live site and are replaced each time Mundus is deployed. Switch modes below; click the image to open that mode."
        zh="这些截图从线上版本读取，Mundus 每次部署后都会更新。在下方切换模式，点击图片可打开对应模式。"
      />
    </p>
  </header>

  <figure class="overview-visual" data-manifest-url={manifestUrl}>
    <span id="mundus-preview-new-tab-label" class="sr-only">
      <Localized
        en="Opens Mundus in a new tab."
        zh="在新标签页打开 Mundus。"
      />
    </span>
    <div id="mundus-preview-panel">
      <a
        class="preview-link"
        href={site.links.mundusWebsite}
        target="_blank"
        rel="noopener noreferrer"
        data-preview-link
        aria-describedby="mundus-preview-new-tab-label"
      >
        <img
          src={asset(fallback.image)}
          alt={fallback.alt.en}
          width="1920"
          height="1080"
          data-preview-image
          data-alt-en={fallback.alt.en}
          data-alt-zh={fallback.alt.zh}
          loading="lazy"
        />
        <span class="preview-action" aria-hidden="true">
          <Localized en="Open ↗" zh="打开 ↗" />
        </span>
      </a>
    </div>
    <figcaption role="tablist" aria-label="Mundus mode preview" data-preview-tabs hidden></figcaption>
  </figure>
</section>

<script>
  type Locale = 'en' | 'zh';
  type Localized = Record<Locale, string>;
  interface PreviewMode {
    id: string;
    href: string;
    title: Localized;
    question: Localized;
    image: { src: Localized; alt: Localized };
  }

  const preview = document.querySelector<HTMLElement>('.mundus-preview');
  const figure = preview?.querySelector<HTMLElement>('[data-manifest-url]');
  const panel = preview?.querySelector<HTMLElement>('#mundus-preview-panel');
  const link = preview?.querySelector<HTMLAnchorElement>('[data-preview-link]');
  const image = preview?.querySelector<HTMLImageElement>('[data-preview-image]');
  const tablist = preview?.querySelector<HTMLElement>('[data-preview-tabs]');

  const locale = (): Locale =>
    document.documentElement.dataset.locale === 'zh' ? 'zh' : 'en';

  const isLocalized = (value: unknown): value is Localized =>
    typeof value === 'object' &&
    value !== null &&
    typeof (value as Localized).en === 'string' &&
    typeof (value as Localized).zh === 'string';

  // Only accept modes whose links and images stay on the Mundus site.
  const readModes = (value: unknown, manifestUrl: string): PreviewMode[] => {
    const manifest = value as { schemaVersion?: unknown; modes?: unknown };
    if (manifest?.schemaVersion !== 1 || !Array.isArray(manifest.modes)) return [];
    const origin = new URL(manifestUrl).origin;
    const sameSite = (url: string) => new URL(url).origin === origin;
    const modes: PreviewMode[] = [];
    for (const entry of manifest.modes) {
      const id = entry?.id;
      const src = entry?.image?.src;
      const alt = entry?.image?.alt;
      if (
        typeof id !== 'string' ||
        !/^[a-z0-9-]+$/.test(id) ||
        typeof entry.href !== 'string' ||
        !isLocalized(entry.title) ||
        !isLocalized(entry.question) ||
        !isLocalized(src) ||
        !isLocalized(alt)
      ) {
        return [];
      }
      const href = new URL(entry.href, manifestUrl).href;
      const images = {
        en: new URL(src.en, manifestUrl).href,
        zh: new URL(src.zh, manifestUrl).href,
      };
      if (![href, images.en, images.zh].every(sameSite)) return [];
      modes.push({
        id,
        href,
        title: entry.title,
        question: entry.question,
        image: { src: images, alt },
      });
    }
    return modes;
  };

  const localizedSpans = (text: Localized) => {
    const fragment = document.createDocumentFragment();
    for (const [key, lang] of [['en', 'en'], ['zh', 'zh-CN']] as const) {
      const span = document.createElement('span');
      span.lang = lang;
      span.dataset.localeContent = key;
      span.textContent = text[key];
      fragment.append(span);
    }
    return fragment;
  };

  const renderTabs = (modes: PreviewMode[]) => {
    if (!preview || !panel || !link || !image || !tablist) return;
    const tabs = modes.map((mode, index) => {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.id = `mundus-preview-${mode.id}`;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', 'mundus-preview-panel');
      tab.setAttribute('aria-selected', 'false');
      tab.tabIndex = index === 0 ? 0 : -1;
      tab.dataset.previewTab = '';
      tab.dataset.modeId = mode.id;
      tab.dataset.href = mode.href;
      const number = document.createElement('small');
      number.textContent = String(index + 1).padStart(2, '0');
      const title = document.createElement('strong');
      title.append(localizedSpans(mode.title));
      const question = document.createElement('em');
      question.append(localizedSpans(mode.question));
      tab.append(number, title, question);
      return tab;
    });
    const byTab = new Map(tabs.map((tab, index) => [tab, modes[index]]));
    let requestId = 0;

    const activate = (tab: HTMLButtonElement) => {
      const mode = byTab.get(tab);
      if (!mode) return;
      const current = locale();
      const src = mode.image.src[current];
      tab.dataset.src = src;
      const currentRequest = ++requestId;
      const candidate = new Image();
      candidate.onload = () => {
        if (currentRequest !== requestId) return;
        image.src = src;
        image.alt = mode.image.alt[current];
        image.dataset.altEn = mode.image.alt.en;
        image.dataset.altZh = mode.image.alt.zh;
        link.href = mode.href;
        tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
        });
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        link.setAttribute('aria-labelledby', tab.id);
        tablist.hidden = false;
      };
      candidate.onerror = () => {
        if (currentRequest !== requestId) return;
        const selected = tabs.find(
          (item) => item.getAttribute('aria-selected') === 'true',
        );
        if (document.activeElement === tab && selected) selected.focus();
      };
      candidate.src = src;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const offsets: Record<string, number> = {
          ArrowLeft: -1,
          ArrowUp: -1,
          ArrowRight: 1,
          ArrowDown: 1,
        };
        let next = index;
        if (event.key in offsets) {
          next = (index + offsets[event.key] + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          next = 0;
        } else if (event.key === 'End') {
          next = tabs.length - 1;
        } else {
          return;
        }
        event.preventDefault();
        tabs[next].focus();
        activate(tabs[next]);
      });
    });

    new MutationObserver(() => {
      const selected = tabs.find(
        (tab) => tab.getAttribute('aria-selected') === 'true',
      );
      if (selected) activate(selected);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-locale'],
    });

    tablist.replaceChildren(...tabs);
    activate(tabs[0]);
  };

  const syncFallbackAlt = () => {
    if (!image || image.closest('[role="tabpanel"]')) return;
    image.alt = image.dataset[locale() === 'zh' ? 'altZh' : 'altEn'] ?? '';
  };

  const load = async (manifestUrl: string) => {
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 10_000);
    try {
      const response = await fetch(manifestUrl, { signal: controller.signal });
      if (!response.ok) return;
      const modes = readModes(await response.json(), manifestUrl);
      if (modes.length > 0) renderTabs(modes);
    } catch {
      // Keep the committed fallback image and the plain link to Mundus.
    } finally {
      window.clearTimeout(timeout);
    }
  };

  if (figure && image) {
    const manifestUrl = figure.dataset.manifestUrl ?? '';
    new MutationObserver(syncFallbackAlt).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-locale'],
    });
    syncFallbackAlt();
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void load(manifestUrl);
        },
        { rootMargin: '600px 0px' },
      );
      observer.observe(figure);
    } else {
      void load(manifestUrl);
    }
  }
</script>

<style>
  .product-story {
    --paper: #151917;
    --ink: #f1eee6;
    --muted: #a8b0aa;
    --line: #414843;
    --signal: #8ec8d7;
    box-sizing: border-box;
    width: 100%;
    margin: 5rem 0;
    padding: clamp(1.5rem, 6vw, 4rem);
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 3vw, 1.75rem);
  }
  header { max-width: 800px; }
  .eyebrow { margin: 0; color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h2 { color: var(--ink); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
  h2 { margin: 1rem 0 1.25rem; font-size: clamp(2.5rem, 6vw, 5rem); }
  header > p:last-child { color: var(--muted); line-height: 1.65; }
  .overview-visual { margin: clamp(2.5rem, 6vw, 5rem) 0 0; }
  .preview-link { position: relative; display: block; overflow: hidden; border: 1px solid var(--line); background: #090b0a; }
  .preview-link img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; opacity: 1; transition: opacity 160ms ease; }
  .preview-action { position: absolute; right: 1rem; bottom: 1rem; padding: .45rem .7rem; color: var(--ink); background: rgb(9 11 10 / .82); border: 1px solid var(--line); border-radius: 999px; font-size: .7rem; }
  .overview-visual figcaption { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .5rem; margin-top: .5rem; }
  .overview-visual figcaption[hidden] { display: none; }
  .overview-visual :global([data-preview-tab]) { display: grid; gap: .25rem; min-height: 4.75rem; padding: 1rem; color: var(--muted); text-align: left; cursor: pointer; background: transparent; border: 1px solid var(--line); font: inherit; }
  .overview-visual :global([data-preview-tab][aria-selected='true']) { color: var(--ink); background: rgb(142 200 215 / .09); border-color: var(--signal); box-shadow: inset 0 2px 0 var(--signal); }
  .overview-visual :global([data-preview-tab]:focus-visible), .preview-link:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
  .overview-visual :global(small) { color: var(--signal); font-size: .65rem; letter-spacing: .1em; }
  .overview-visual :global(strong) { color: var(--ink); font-size: .9rem; }
  .overview-visual :global(em) { color: var(--muted); font-size: .72rem; font-style: normal; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .product-story { margin: 4rem 0; }
    .overview-visual figcaption { grid-template-columns: 1fr; }
    .overview-visual :global([data-preview-tab]) { grid-template-columns: 2rem 1fr; align-items: center; min-height: 44px; }
    .overview-visual :global([data-preview-tab] em) { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .preview-link img { transition: none; }
  }
  :global(.chronorbis-vision) {
    box-sizing: border-box;
    width: 100%;
    margin: clamp(4rem, 9vw, 8rem) 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: #28251f;
    background: #ece3ce;
    border: 1px solid #c8b994;
    border-radius: 14px;
  }
  :global(.chronorbis-status) {
    color: #725632;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  :global(.chronorbis-structure) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin-top: 2rem;
  }
  :global(.chronorbis-structure span) {
    padding: .85rem 1rem;
    color: #4f493d;
    background: rgb(255 255 255 / .28);
    border-left: 2px solid #8d6d3f;
  }
  @media (max-width: 560px) {
    :global(.chronorbis-vision) {
      padding: 1rem;
    }
    :global(.chronorbis-structure) {
      grid-template-columns: 1fr;
    }
  }
</style>
