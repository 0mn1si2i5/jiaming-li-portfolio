---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Localized from '../components/Localized.astro';
import { site } from '../config/site';

const projects = await getCollection('projects');
const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const otherProjects = projects
  .filter((project) => !project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <section class="hero page-width">
    <p class="eyebrow">Jiaming Li · 李佳鸣</p>
    <h1><Localized en="I make tools for thinking, exploring, and connecting." zh="我设计并开发 AI 与交互产品。" /></h1>
    <div class="hero-bottom">
      <p><Localized en="I am a product builder and researcher interested in how people work with AI, understand information, and turn a small curiosity into something shareable." zh="我关注人们如何使用 AI、理解复杂信息，以及如何将一个想法转化为可用、可分享的产品。" /></p>
      <a class="quiet-link" href="#work"><Localized en="Selected explorations" zh="精选探索" /> <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="work" class="work-section page-width" aria-labelledby="work-title">
    <div class="section-heading"><p class="eyebrow"><Localized en="Selected work" zh="精选项目" /></p><h2 id="work-title"><Localized en="Things I have been following closely." zh="持续推进的项目。" /></h2></div>
    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <article class:list={['project-card', `accent-${project.data.accent}`]}>
          <div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
          <a class="media-link" href={`${base}projects/${project.id}`}><ProjectMedia project={project} compact /></a>
          <div class="project-copy">
            <div class="meta project-meta">
              <span class="kind"><Localized {...project.data.kind} /></span>
              <span><Localized {...project.data.year} /></span>
            </div>
            <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
            <p><Localized {...project.data.summary} /></p>
            <p class="status"><span><Localized en="Status" zh="状态" /></span><Localized {...project.data.status} /></p>
            <a class="project-link" href={`${base}projects/${project.id}`}><Localized en="Read the exploration" zh="查看项目详情" /> <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="other-section page-width" aria-labelledby="other-title">
    <p class="eyebrow"><Localized en="Other work" zh="其他作品" /></p>
    <div class="other-grid">
      <h2 id="other-title"><Localized en="Small things with a longer life." zh="同样值得记录的项目。" /></h2>
      <div class="other-list">
        {otherProjects.map((project) => (
          <article class="other-card">
            <a class="other-media" href={`${base}projects/${project.id}`}><ProjectMedia project={project} compact /></a>
            <div class="other-copy">
              <p class="meta"><span><Localized {...project.data.year} /></span><span><Localized {...project.data.kind} /></span></p>
              <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
              <p><Localized {...project.data.summary} /></p>
              <a href={`${base}projects/${project.id}`}><Localized en="Read the exploration" zh="查看项目详情" /> <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
        <article class="other-card external-card"><div class="other-copy"><p class="meta"><span><Localized en="May 2022" zh="2022 年 5 月" /></span><span><Localized en="Community mod" zh="社区模组" /></span></p><h3>RSZ Namelist</h3><p><Localized en="A Chinese naming enhancement mod for Stellaris, made to let a universe feel more at home in Chinese." zh="为《群星》提供更符合中文语境的舰船、星球与人物默认名称，改善中文玩家的沉浸体验。" /></p><p class="outcome"><Localized en="5,000+ active users" zh="5,000+ 活跃用户" /></p><a href={site.links.rsz} target="_blank" rel="noreferrer"><Localized en="Visit Steam Workshop" zh="前往 Steam 创意工坊" /> <span aria-hidden="true">↗</span></a></div></article>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .eyebrow, .meta { margin: 0; color: var(--muted); font-size: .78rem; font-weight: 650; letter-spacing: .075em; text-transform: uppercase; }
  .hero { min-height: min(700px, calc(100vh - 84px)); padding: clamp(5rem, 11vw, 10rem) 0 4rem; display: flex; flex-direction: column; justify-content: space-between; }
  h1, h2, h3, p { margin-top: 0; } h1, h2, h3 { letter-spacing: var(--display-tracking); line-height: .98; }
  h1 { max-width: 1000px; margin: 3rem 0; font-size: clamp(3.35rem, 7.1vw, 7.1rem); } h1 em { font-family: Georgia, serif; font-weight: 400; }
  .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; } .hero-bottom p { max-width: 430px; margin: 0; color: var(--muted); font-size: 1.08rem; }
  .quiet-link, .project-link, .other-card a { font-weight: 620; text-decoration: none; } .quiet-link:hover, .project-link:hover, .other-card a:hover { text-decoration: underline; }
  .work-section { padding: var(--space-section) 0; border-top: 1px solid var(--rule-strong); }.section-heading { display: flex; justify-content: space-between; margin-bottom: clamp(4rem, 7vw, 7rem); }.section-heading h2, .other-section h2 { margin-bottom: 0; font-size: clamp(2.4rem, 5vw, 4.6rem); }
  .project-list { display: grid; gap: clamp(5rem, 10vw, 10rem); }
  .project-card { position: relative; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, .72fr); align-items: center; gap: clamp(2.5rem, 6vw, 6.5rem); padding-top: 2.25rem; border-top: 1px solid var(--rule-strong); }
  .project-card:nth-child(even) { grid-template-columns: minmax(260px, .72fr) minmax(0, 1.55fr); }
  .project-card:nth-child(even) .media-link { order: 2; }
  .project-card:nth-child(even) .project-copy { order: 1; }
  .project-index { position: absolute; top: 0; left: 0; transform: translateY(-50%); padding-right: .75rem; color: var(--muted); background: var(--paper); font-size: .72rem; font-weight: 650; letter-spacing: .14em; line-height: 1; }
  .project-card:nth-child(even) .project-index { right: 0; left: auto; padding: 0 0 0 .75rem; }
  .media-link { display: block; }
  .project-copy .meta, .other-card .meta { display: flex; justify-content: space-between; gap: 1rem; }
  .project-meta .kind { color: var(--ink); }
  .project-copy h3 { margin: 1.15rem 0 1rem; font-family: var(--font-display); font-size: clamp(3rem, 5vw, 5.3rem); font-weight: 400; letter-spacing: -.055em; }
  .project-copy h3 a, .other-card h3 a { text-decoration: none; }
  .project-copy > p:not(.status) { max-width: 380px; color: var(--muted); }
  .project-copy .status { display: grid; grid-template-columns: 4.5rem 1fr; max-width: 380px; margin: 1.5rem 0 0; padding-top: .9rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .82rem; }
  .project-copy .status span:first-child { color: var(--ink); font-size: .68rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .project-link { display: inline-block; margin-top: 1.2rem; }.accent-violet .project-link { color: var(--violet); }.accent-coral .project-link { color: var(--coral); }.accent-blue .project-link { color: var(--blue); }
  .other-section { padding: var(--space-section) 0; border-top: 1px solid var(--rule-strong); }.other-section > .eyebrow { margin-bottom: 1.5rem; }.other-grid { display: grid; grid-template-columns: minmax(260px, .75fr) minmax(0, 1.25fr); gap: clamp(3rem, 7vw, 7rem); }.other-list { display: grid; gap: 1.5rem; }.other-card { display: grid; grid-template-columns: minmax(150px, .8fr) minmax(0, 1.2fr); max-width: 680px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }.other-media { display: block; min-height: 100%; overflow: hidden; }.other-media :global(.project-media) { height: 100%; border: 0; border-right: 1px solid var(--line); border-radius: 0; transition: filter 180ms ease, transform 180ms ease; }.other-media:hover :global(.project-media), .other-media:focus-visible :global(.project-media) { filter: brightness(1.04) saturate(1.05); transform: scale(1.015); }.other-media:focus-visible { z-index: 1; outline-offset: -4px; }.other-copy { padding: 1.5rem; }.other-card h3 { margin: 1.5rem 0 .75rem; font-family: var(--font-display); font-size: 2rem; font-weight: 400; letter-spacing: -.035em; }.other-card p { color: var(--muted); }.other-card .outcome { margin: 1.7rem 0 .6rem; color: var(--ink); font-weight: 650; }.other-card a { color: var(--blue); }.external-card { display: block; margin-left: clamp(0rem, 5vw, 3.5rem); background: transparent; border-color: var(--rule-strong); }
  :global(:root[data-locale='zh']) .hero h1 { max-width: 15ch; font-size: clamp(2.8rem, 5.8vw, 5.2rem); line-height: 1.16; letter-spacing: -.045em; }
  :global(:root[data-locale='zh']) .section-heading h2, :global(:root[data-locale='zh']) .other-section h2 { font-size: clamp(2.1rem, 4.2vw, 3.75rem); line-height: 1.2; letter-spacing: -.04em; }
  :global(:root[data-locale='zh']) .project-copy h3 { font-family: var(--font-display-zh); font-size: clamp(2.4rem, 4vw, 4rem); line-height: 1.18; letter-spacing: -.04em; }
  :global(:root[data-locale='zh']) .other-card h3 { font-family: var(--font-display-zh); letter-spacing: -.025em; }
  @media (max-width: 760px) { .hero { min-height: 620px; }.hero-bottom, .section-heading, .project-card, .project-card:nth-child(even), .other-grid { grid-template-columns: 1fr; display: grid; }.hero-bottom { align-items: start; }.project-card:nth-child(even) .media-link, .project-card:nth-child(even) .project-copy { order: initial; }.project-card:nth-child(even) .project-index { right: auto; left: 0; padding: 0 .75rem 0 0; }.project-list { gap: 5rem; }.work-section, .other-section { padding: 5rem 0; }.section-heading { gap: 1.3rem; }.external-card { margin-left: 0; } }
  @media (max-width: 560px) { h1 { font-size: clamp(3rem, 15vw, 4.6rem); }.hero { min-height: calc(100svh - 116px); padding-top: 4rem; }.project-card { gap: 1.5rem; }.project-copy h3 { font-size: clamp(3rem, 15vw, 4.4rem); }.other-card { grid-template-columns: 1fr; }.other-media :global(.project-media) { aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--line); }:global(:root[data-locale='zh']) .hero h1 { max-width: none; font-size: clamp(2.45rem, 10.2vw, 3.75rem); }:global(:root[data-locale='zh']) .section-heading h2, :global(:root[data-locale='zh']) .other-section h2 { font-size: clamp(2rem, 8vw, 2.8rem); } }
</style>
