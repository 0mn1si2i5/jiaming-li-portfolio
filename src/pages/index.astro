---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Localized from '../components/Localized.astro';
import { site } from '../config/site';

const projects = await getCollection('projects');
const featuredProjectIds = ['dialogtree', 'mundus'] as const;
const internshipProjectIds = ['bytedance-ai-data'] as const;
const projectById = (id: string) => projects.find((project) => project.id === id)!;
const featuredProjects = featuredProjectIds.map(projectById);
const internshipProjects = internshipProjectIds.map(projectById);
const otherProjects = projects
  .filter(
    (project) =>
      !(featuredProjectIds as readonly string[]).includes(project.id) &&
      !(internshipProjectIds as readonly string[]).includes(project.id),
  )
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <section class="hero page-width">
    <p class="eyebrow">Jiaming Li · 李佳鸣</p>
    <h1><Localized en="I work across product development, research, and independent projects." zh="产品、研究与独立开发。" /></h1>
    <div class="hero-bottom">
      <p><Localized en="This portfolio brings together independent projects I continue to maintain, collaborative research, and work completed during internships, spanning interaction products, research prototypes, speech evaluation, and data tooling." zh="这里收录了我持续维护的个人作品、参与的合作研究，以及实习期间完成的项目，内容包括交互产品、研究原型、语音评测与数据工具。" /></p>
      <a class="quiet-link" href="#work"><Localized en="View projects" zh="查看项目" /> <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="work" class="work-section page-width" aria-labelledby="work-title">
    <div class="section-heading"><p class="eyebrow"><Localized en="Work" zh="项目" /></p><h2 id="work-title"><Localized en="Featured projects" zh="重点项目" /></h2></div>
    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <article class:list={['project-card', `accent-${project.data.accent}`]}>
          <div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
          <a class="media-link" href={`${base}projects/${project.id}`}><ProjectMedia project={project} compact /></a>
          <div class="project-copy">
            <div class="meta project-meta">
              <span class="kind"><Localized {...project.data.kind} /></span>
              <span><Localized {...project.data.year} /></span>
            </div>
            <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
            <p><Localized {...project.data.summary} /></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="internship" class="internship-section page-width" aria-labelledby="internship-title">
    <div class="section-heading"><p class="eyebrow"><Localized en="Internship" zh="实习项目" /></p><h2 id="internship-title"><Localized en="Internship project" zh="实习项目" /></h2></div>
    <div class="project-list">
      {internshipProjects.map((project) => (
        <article class:list={['project-card', 'internship-card', `accent-${project.data.accent}`]}>
          <a class="media-link" href={`${base}projects/${project.id}`}><ProjectMedia project={project} compact /></a>
          <div class="project-copy">
            <div class="meta project-meta">
              <span class="kind"><Localized {...project.data.kind} /></span>
              <span><Localized {...project.data.year} /></span>
            </div>
            <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
            <p><Localized {...project.data.summary} /></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="other-section page-width" aria-labelledby="other-title">
    <p class="eyebrow"><Localized en="More projects" zh="更多项目" /></p>
    <div class="other-grid">
      <h2 id="other-title"><Localized en="Independent work and experiments" zh="独立作品与实验" /></h2>
      <div class="other-list">
        {otherProjects.map((project) => (
          <article class="other-card">
            <a class="other-media" href={`${base}projects/${project.id}`}><ProjectMedia project={project} compact /></a>
            <div class="other-copy">
              <p class="meta"><span><Localized {...project.data.year} /></span><span><Localized {...project.data.kind} /></span></p>
              <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
              <p><Localized {...project.data.summary} /></p>
            </div>
          </article>
        ))}
        {site.externalWork.map((item) => (
          <article class="other-card external-card">
            <div class="other-copy">
              <p class="meta"><span><Localized {...item.year} /></span><span><Localized {...item.kind} /></span></p>
              <h3><Localized {...item.title} /></h3>
              <p><Localized {...item.summary} /></p>
              <a class="external-link" href={item.href} target="_blank" rel="noreferrer"><Localized en="View on GitHub" zh="在 GitHub 查看" /> <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
        <article class="other-card external-card"><div class="other-copy"><p class="meta"><span><Localized en="May 2022" zh="2022 年 5 月" /></span><span><Localized en="Community mod" zh="社区模组" /></span></p><h3>RSZ Namelist</h3><p><Localized en="A Chinese naming enhancement mod for Stellaris, made to let a universe feel more at home in Chinese." zh="为《群星》提供更符合中文语境的舰船、星球与人物默认名称，改善中文玩家的沉浸体验。" /></p><p class="outcome"><Localized en="5,000+ active users" zh="5,000+ 活跃用户" /></p><a class="external-link" href={site.links.rsz} target="_blank" rel="noreferrer"><Localized en="Visit Steam Workshop" zh="前往 Steam 创意工坊" /> <span aria-hidden="true">↗</span></a></div></article>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .eyebrow, .meta { margin: 0; color: var(--muted); font-size: .78rem; font-weight: 650; letter-spacing: .075em; text-transform: uppercase; }
  .hero { min-height: clamp(520px, 72vh, 660px); padding: clamp(5rem, 11vw, 10rem) 0 4rem; display: flex; flex-direction: column; justify-content: space-between; }
  h1, h2, h3, p { margin-top: 0; } h1, h2, h3 { letter-spacing: var(--display-tracking); line-height: .98; }
  h1 { max-width: 1000px; margin: 3rem 0; font-size: clamp(3.35rem, 7.1vw, 7.1rem); } h1 em { font-family: Georgia, serif; font-weight: 400; }
  .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; } .hero-bottom p { max-width: 430px; margin: 0; color: var(--muted); font-size: 1.08rem; }
  .quiet-link { font-weight: 620; text-decoration: none; }.quiet-link:hover { text-decoration: underline; }
  .work-section { padding: var(--space-section) 0; border-top: 1px solid var(--rule-strong); }.section-heading { display: flex; justify-content: space-between; margin-bottom: clamp(4rem, 7vw, 7rem); }.section-heading h2, .other-section h2 { margin-bottom: 0; font-size: clamp(2.4rem, 5vw, 4.6rem); }
  .internship-section { padding: var(--space-section) 0; border-top: 1px solid var(--rule-strong); }.internship-section .section-heading { margin-bottom: clamp(3rem, 5vw, 5rem); }.internship-card .project-copy h3 { font-size: clamp(2.4rem, 4vw, 4rem); }
  .project-list { display: grid; gap: clamp(5rem, 10vw, 10rem); }
  .project-card { position: relative; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, .72fr); align-items: center; gap: clamp(2.5rem, 6vw, 6.5rem); padding-top: 2.25rem; border-top: 1px solid var(--rule-strong); }
  .project-card:nth-child(even) { grid-template-columns: minmax(260px, .72fr) minmax(0, 1.55fr); }
  .project-card:nth-child(even) .media-link { order: 2; }
  .project-card:nth-child(even) .project-copy { order: 1; }
  .project-index { position: absolute; top: 0; left: 0; transform: translateY(-50%); padding-right: .75rem; color: var(--muted); background: var(--paper); font-size: .72rem; font-weight: 650; letter-spacing: .14em; line-height: 1; }
  .project-card:nth-child(even) .project-index { right: 0; left: auto; padding: 0 0 0 .75rem; }
  .media-link, .other-media { display: block; overflow: hidden; }
  .media-link :global(.project-media), .other-media :global(.project-media) { transition: filter 180ms ease, transform 180ms ease; }
  .media-link:hover :global(.project-media), .media-link:focus-visible :global(.project-media), .other-media:hover :global(.project-media), .other-media:focus-visible :global(.project-media) { filter: brightness(1.04) saturate(1.05); transform: scale(1.015); }
  .project-copy .meta, .other-card .meta { display: flex; justify-content: space-between; gap: 1rem; }
  .project-meta .kind { color: var(--ink); }
  .project-copy h3 { margin: 1.15rem 0 1rem; font-family: var(--font-display); font-size: clamp(3rem, 5vw, 5.3rem); font-weight: 400; letter-spacing: -.055em; }
  .project-copy h3 a, .other-copy > h3 a { color: var(--ink); text-decoration: none; }
  .project-copy h3 a:hover, .project-copy h3 a:focus-visible, .other-copy > h3 a:hover, .other-copy > h3 a:focus-visible { text-decoration: underline; }
  .project-copy > p { max-width: 380px; color: var(--muted); }
  .other-section { padding: var(--space-section) 0; border-top: 1px solid var(--rule-strong); }.other-section > .eyebrow { margin-bottom: 1.5rem; }.other-grid { display: grid; grid-template-columns: minmax(260px, .75fr) minmax(0, 1.25fr); gap: clamp(3rem, 7vw, 7rem); }.other-list { display: grid; gap: 1.5rem; }.other-card { display: grid; grid-template-columns: minmax(150px, .8fr) minmax(0, 1.2fr); max-width: 680px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }.other-media { min-height: 100%; }.other-media :global(.project-media) { width: 100%; height: 100%; aspect-ratio: auto; border: 0; border-right: 1px solid var(--line); border-radius: 0; }.other-media :global(.preview-media img) { object-fit: contain; }.other-media:focus-visible { z-index: 1; outline-offset: -4px; }.other-copy { padding: 1.5rem; }.other-card h3 { margin: 1.5rem 0 .75rem; font-family: var(--font-display); font-size: 2rem; font-weight: 400; letter-spacing: -.035em; }.other-card p { color: var(--muted); }.other-card .outcome { margin: 1.7rem 0 .6rem; color: var(--ink); font-weight: 650; }.external-link { color: var(--external-link); }.external-card { display: block; margin-left: clamp(0rem, 5vw, 3.5rem); background: transparent; border-color: var(--rule-strong); }
  :global(:root[data-locale='zh']) .hero h1 { max-width: 15ch; font-size: clamp(2.8rem, 5.8vw, 5.2rem); line-height: 1.16; letter-spacing: -.045em; }
  :global(:root[data-locale='zh']) .section-heading h2, :global(:root[data-locale='zh']) .other-section h2 { font-size: clamp(2.1rem, 4.2vw, 3.75rem); line-height: 1.2; letter-spacing: -.04em; }
  :global(:root[data-locale='zh']) .project-copy h3 { font-family: var(--font-display-zh); font-size: clamp(2.4rem, 4vw, 4rem); line-height: 1.18; letter-spacing: -.04em; }
  :global(:root[data-locale='zh']) .other-card h3 { font-family: var(--font-display-zh); letter-spacing: -.025em; }
  @media (max-width: 760px) { .hero { min-height: 620px; }.hero-bottom, .section-heading, .project-card, .project-card:nth-child(even), .other-grid { grid-template-columns: 1fr; display: grid; }.hero-bottom { align-items: start; }.project-card:nth-child(even) .media-link, .project-card:nth-child(even) .project-copy { order: initial; }.project-card:nth-child(even) .project-index { right: auto; left: 0; padding: 0 .75rem 0 0; }.project-list { gap: 5rem; }.work-section, .internship-section, .other-section { padding: 5rem 0; }.section-heading { gap: 1.3rem; }.external-card { margin-left: 0; } }
  @media (max-width: 560px) { h1 { font-size: clamp(3rem, 15vw, 4.6rem); }.hero { min-height: calc(100svh - 116px); padding-top: 4rem; }.project-card { gap: 1.5rem; }.project-copy h3 { font-size: clamp(3rem, 15vw, 4.4rem); }.other-card { grid-template-columns: 1fr; }.other-media :global(.project-media) { height: auto; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--line); }:global(:root[data-locale='zh']) .hero h1 { max-width: none; font-size: clamp(2.45rem, 10.2vw, 3.75rem); }:global(:root[data-locale='zh']) .section-heading h2, :global(:root[data-locale='zh']) .other-section h2 { font-size: clamp(2rem, 8vw, 2.8rem); } }
  @media (max-height: 720px) and (min-width: 1000px) { .hero { padding-top: 2.5rem; } }
</style>
