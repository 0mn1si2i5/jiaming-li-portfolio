---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Localized from '../components/Localized.astro';
import EmailContact from '../components/EmailContact.astro';
import { site } from '../config/site';

const projects = await getCollection('projects');
const featuredProjectIds = ['dialogtree', 'perch', 'mundus'] as const;
const projectById = (id: string) => projects.find((project) => project.id === id)!;
const featuredProjects = featuredProjectIds.map(projectById);
const otherProjects = projects
  .filter((project) => !project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <section class="hero page-width">
    <p class="eyebrow">Jiaming Li · 李佳鸣</p>
    <h1><Localized en="I build AI tools, interactive products, and research prototypes." zh="做 AI 工具、交互产品和研究原型。" /></h1>
    <div class="hero-bottom">
      <div class="hero-copy">
        <p class="now"><span class="now-label"><Localized en="Now" zh="现在" /></span><Localized {...site.now} /></p>
        <p><Localized en="This portfolio brings together independent projects I continue to maintain, collaborative research, and work completed during internships." zh="这里收录了我持续维护的个人作品、参与的合作研究，以及实习期间完成的项目。" /></p>
      </div>
      <a class="quiet-link" href="#work"><Localized en="View projects" zh="查看项目" /> <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="work" class="work-section page-width" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="eyebrow"><Localized en="Work" zh="项目" /></p>
      <h2 id="work-title"><Localized en="Featured projects" zh="重点项目" /></h2>
    </div>
    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <article class="project-card">
          <div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
          <a class="media-link" href={`${base}projects/${project.id}`} tabindex="-1" aria-hidden="true"><ProjectMedia project={project} compact /></a>
          <div class="project-copy">
            <div class="meta project-meta">
              <span class="kind"><Localized {...project.data.kind} /></span>
              <span class="period"><Localized {...project.data.year} /></span>
            </div>
            <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
            <p><Localized {...project.data.summary} /></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="experience-section page-width" aria-labelledby="experience-title">
    <div class="section-heading">
      <p class="eyebrow"><Localized en="Experience" zh="经历" /></p>
      <h2 id="experience-title"><Localized en="Internships and research" zh="实习与研究" /></h2>
    </div>
    <ol class="timeline">
      {site.experience.map((item) => (
        <li class="timeline-entry">
          <p class="period"><Localized {...item.period} /></p>
          <div class="timeline-title">
            <h3><Localized {...item.org} /></h3>
            <p class="role"><Localized {...item.role} /></p>
          </div>
          <div class="timeline-copy">
            <p><Localized {...item.summary} /></p>
            {'link' in item && 'project' in item.link && (
              <a class="text-link" href={`${base}projects/${item.link.project}`}><Localized {...item.link.label} /> <span aria-hidden="true">→</span></a>
            )}
            {'link' in item && 'href' in item.link && (
              <a class="external-link" href={item.link.href} target="_blank" rel="noreferrer"><Localized {...item.link.label} /> <span aria-hidden="true">↗</span></a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="other-section page-width" aria-labelledby="other-title">
    <p class="eyebrow"><Localized en="More projects" zh="更多项目" /></p>
    <div class="other-grid">
      <h2 id="other-title"><Localized en="Independent work and experiments" zh="独立作品与实验" /></h2>
      <div class="other-list">
        {otherProjects.map((project) => (
          <article class="other-card">
            <a class="other-media" href={`${base}projects/${project.id}`} tabindex="-1" aria-hidden="true"><ProjectMedia project={project} compact /></a>
            <div class="other-copy">
              <p class="meta"><span><Localized {...project.data.year} /></span><span><Localized {...project.data.kind} /></span></p>
              <h3><a href={`${base}projects/${project.id}`}><Localized {...project.data.title} /></a></h3>
              <p><Localized {...project.data.summary} /></p>
            </div>
          </article>
        ))}
        {site.externalWork.map((item) => (
          <article class="other-card external-card">
            <div class="other-copy">
              <p class="meta"><span><Localized {...item.year} /></span><span><Localized {...item.kind} /></span></p>
              <h3><Localized {...item.title} /></h3>
              <p><Localized {...item.summary} /></p>
              {'outcome' in item && <p class="outcome"><Localized {...item.outcome} /></p>}
              <a class="external-link" href={item.href} target="_blank" rel="noreferrer"><Localized {...item.linkLabel} /> <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section page-width" aria-labelledby="contact-title">
    <p class="eyebrow"><Localized en="Contact" zh="联系" /></p>
    <div class="contact-grid">
      <h2 id="contact-title"><Localized en="Email is the best way to reach me." zh="联系我最方便的方式是邮件。" /></h2>
      <div>
        <div class="email-list">
          {site.emails.map((email) => (
            <EmailContact {...email} />
          ))}
        </div>
        <div class="contact-actions">
          <a class="external-link" href={`${base}${site.resumePath}`}><Localized en="Download résumé (Chinese, PDF)" zh="下载简历（PDF）" /> <span aria-hidden="true">↓</span></a>
          <a class="external-link" href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow,
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 650;
    letter-spacing: .075em;
    text-transform: uppercase;
  }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { letter-spacing: var(--display-tracking); line-height: .98; }

  /* Hero */
  .hero {
    min-height: clamp(520px, 72vh, 660px);
    padding: clamp(5rem, 11vw, 10rem) 0 4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  h1 { max-width: 1000px; margin: 3rem 0; font-size: clamp(3.35rem, 7.1vw, 7.1rem); }
  .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .hero-copy { max-width: 460px; }
  .hero-copy p { margin: 0; color: var(--muted); font-size: 1.08rem; }
  .hero-copy .now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .35rem .75rem;
    margin-bottom: 1rem;
    color: var(--ink);
    font-weight: 560;
  }
  .now-label {
    color: var(--muted);
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .quiet-link { flex: none; font-weight: 620; text-decoration: none; }
  .quiet-link:hover { text-decoration: underline; }

  /* Shared section frame */
  .work-section,
  .experience-section,
  .other-section,
  .contact-section {
    padding: var(--space-section) 0 calc(var(--space-section) + 1rem);
    border-top: 1px solid var(--rule-strong);
  }
  .section-heading { display: flex; justify-content: space-between; gap: 2rem; margin-bottom: clamp(4rem, 7vw, 7rem); }
  .section-heading h2,
  .other-section h2,
  .contact-section h2 { margin-bottom: 0; font-size: clamp(2.4rem, 5vw, 4.6rem); }

  /* Featured projects */
  .project-list { display: grid; gap: clamp(5rem, 10vw, 10rem); }
  .project-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(260px, .72fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6.5rem);
    padding-top: 2.25rem;
    border-top: 1px solid var(--rule-strong);
  }
  .project-card:nth-child(even) { grid-template-columns: minmax(260px, .72fr) minmax(0, 1.55fr); }
  .project-card:nth-child(even) .media-link { order: 2; }
  .project-card:nth-child(even) .project-copy { order: 1; }
  .project-index {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(-50%);
    padding-right: .75rem;
    color: var(--muted);
    background: var(--paper);
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .14em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .project-card:nth-child(even) .project-index { right: 0; left: auto; padding: 0 0 0 .75rem; }
  .media-link, .other-media { display: block; overflow: hidden; }
  .media-link :global(.project-media),
  .other-media :global(.project-media) { transition: filter 220ms ease, transform 320ms cubic-bezier(.2, .7, .2, 1); }
  .project-card:hover .media-link :global(.project-media),
  .project-card:focus-within .media-link :global(.project-media),
  .other-card:hover .other-media :global(.project-media),
  .other-card:focus-within .other-media :global(.project-media) { filter: brightness(1.03) saturate(1.04); transform: scale(1.012); }
  .project-copy .meta, .other-card .meta { display: flex; justify-content: space-between; gap: 1rem; }
  .project-meta .kind { color: var(--ink); }
  .period { font-variant-numeric: tabular-nums; }
  .project-copy h3 { margin: 1.15rem 0 1rem; font-family: var(--font-display); font-size: clamp(3rem, 5vw, 5.3rem); font-weight: 400; letter-spacing: -.055em; }
  .project-copy h3 a, .other-copy > h3 a { color: var(--ink); text-decoration: none; }
  .project-copy h3 a::after { content: ''; position: absolute; inset: 0; }
  .project-copy h3 a:hover, .project-copy h3 a:focus-visible, .other-copy > h3 a:hover, .other-copy > h3 a:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; }
  .project-copy > p { max-width: 400px; color: var(--muted); text-wrap: pretty; }

  /* Experience timeline */
  .experience-section .section-heading { margin-bottom: clamp(3rem, 5vw, 5rem); }
  .timeline { margin: 0; padding: 0; list-style: none; }
  .timeline-entry {
    display: grid;
    grid-template-columns: minmax(150px, .3fr) minmax(0, .8fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    padding: 2.25rem 0 2.5rem;
    border-top: 1px solid var(--line);
  }
  .timeline-entry:first-child { border-top-color: var(--rule-strong); }
  .timeline-entry .period { margin: .3rem 0 0; color: var(--muted); font-size: .88rem; font-weight: 560; }
  .timeline-title h3 { margin: 0 0 .5rem; font-size: clamp(1.45rem, 2.2vw, 1.9rem); line-height: 1.15; letter-spacing: -.025em; }
  .timeline-title .role { margin: 0; color: var(--muted); }
  .timeline-copy p { max-width: 520px; margin: .2rem 0 .9rem; text-wrap: pretty; }
  .timeline-copy a { font-weight: 620; }
  .text-link { color: var(--ink); text-decoration: none; }
  .text-link:hover, .text-link:focus-visible { text-decoration: underline; }

  /* More projects */
  .other-section > .eyebrow, .contact-section > .eyebrow { margin-bottom: 1.5rem; }
  .other-grid, .contact-grid { display: grid; grid-template-columns: minmax(260px, .75fr) minmax(0, 1.25fr); gap: clamp(3rem, 7vw, 7rem); }
  .other-list { display: grid; gap: 1.5rem; }
  .other-card { position: relative; display: grid; grid-template-columns: minmax(150px, .8fr) minmax(0, 1.2fr); max-width: 680px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }
  .other-media { min-height: 100%; }
  .other-media :global(.project-media) { width: 100%; height: 100%; aspect-ratio: auto; border: 0; border-right: 1px solid var(--line); border-radius: 0; box-shadow: none; }
  .other-media :global(.preview-media img) { object-fit: contain; }
  .other-copy { padding: 1.5rem; }
  .other-card h3 { margin: 1.5rem 0 .75rem; font-family: var(--font-display); font-size: 2rem; font-weight: 400; letter-spacing: -.035em; }
  .other-card:not(.external-card) h3 a::after { content: ''; position: absolute; inset: 0; }
  .other-card p { color: var(--muted); text-wrap: pretty; }
  .other-card .outcome { margin: 1.7rem 0 .6rem; color: var(--ink); font-weight: 650; font-variant-numeric: tabular-nums; }
  .external-card { display: block; margin-left: clamp(0rem, 5vw, 3.5rem); background: transparent; border-color: var(--rule-strong); }

  /* Contact */
  .email-list { display: grid; gap: 1.1rem; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.75rem; }

  :global(:root[data-locale='zh']) .hero h1 { max-width: 15ch; font-size: clamp(2.8rem, 5.8vw, 5.2rem); line-height: 1.16; letter-spacing: -.045em; }
  :global(:root[data-locale='zh']) .section-heading h2,
  :global(:root[data-locale='zh']) .other-section h2,
  :global(:root[data-locale='zh']) .contact-section h2 { font-size: clamp(2.1rem, 4.2vw, 3.75rem); line-height: 1.2; letter-spacing: -.04em; }
  :global(:root[data-locale='zh']) .project-copy h3 { font-family: var(--font-display-zh); font-size: clamp(2.4rem, 4vw, 4rem); line-height: 1.18; letter-spacing: -.04em; }
  :global(:root[data-locale='zh']) .other-card h3 { font-family: var(--font-display-zh); letter-spacing: -.025em; }

  @media (max-width: 900px) {
    .timeline-entry { grid-template-columns: minmax(120px, .35fr) minmax(0, 1fr); }
    .timeline-copy { grid-column: 2; }
  }
  @media (max-width: 760px) {
    .hero { min-height: 620px; }
    .hero-bottom, .section-heading, .project-card, .project-card:nth-child(even), .other-grid, .contact-grid { display: grid; grid-template-columns: 1fr; }
    .hero-bottom { align-items: start; }
    .project-card:nth-child(even) .media-link, .project-card:nth-child(even) .project-copy { order: initial; }
    .project-card:nth-child(even) .project-index { right: auto; left: 0; padding: 0 .75rem 0 0; }
    .project-list { gap: 5rem; }
    .work-section, .experience-section, .other-section, .contact-section { padding: 5rem 0 5.5rem; }
    .section-heading { gap: 1.3rem; }
    .external-card { margin-left: 0; }
    .timeline-entry { grid-template-columns: 1fr; gap: .9rem; }
    .timeline-copy { grid-column: auto; }
  }
  @media (max-width: 560px) {
    h1 { font-size: clamp(3rem, 15vw, 4.6rem); }
    .hero { min-height: calc(100svh - 116px); padding-top: 4rem; }
    .project-card { gap: 1.5rem; }
    .project-copy h3 { font-size: clamp(3rem, 15vw, 4.4rem); }
    .other-card { grid-template-columns: 1fr; }
    .other-media :global(.project-media) { height: auto; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--line); }
    :global(:root[data-locale='zh']) .hero h1 { max-width: none; font-size: clamp(2.45rem, 10.2vw, 3.75rem); }
    :global(:root[data-locale='zh']) .section-heading h2,
    :global(:root[data-locale='zh']) .other-section h2,
    :global(:root[data-locale='zh']) .contact-section h2 { font-size: clamp(2rem, 8vw, 2.8rem); }
  }
  @media (max-height: 720px) and (min-width: 1000px) { .hero { padding-top: 2.5rem; } }
</style>
