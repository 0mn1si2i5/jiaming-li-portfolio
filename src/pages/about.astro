---
import BaseLayout from '../components/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import EmailContact from '../components/EmailContact.astro';
import { site } from '../config/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="About" description="About Jiaming Li's work across product development, research, and independent projects.">
  <section class="about page-width" aria-labelledby="about-title">
    <div>
      <p class="eyebrow"><Localized en="About" zh="关于" /></p>
      <h1 id="about-title"><Localized en="Research, products, and personal projects." zh="研究、产品与个人项目。" /></h1>
    </div>
    <div class="about-copy">
      <p><Localized en="I'm pursuing an M.S. in Computer Science at the National University of Singapore, where I study human–AI collaboration and generative-AI creation at AI4SG Lab. I previously worked with speech data in ByteDance's AI Data & Security team, contributed to HCI research, and continue to develop independent projects including DialogTree and Mundus." zh="目前在新加坡国立大学攻读计算机硕士，在 AI4SG Lab 研究人机协作与生成式 AI 创作。曾在字节跳动 AI 数据与安全部门从事语音数据相关工作，也参与过 HCI 研究，并持续开发 DialogTree、Mundus 等个人项目。" /></p>
      <div class="contact-block">
        <div class="email-list">
          {site.emails.map((email) => (
            <EmailContact {...email} />
          ))}
        </div>
        <div class="contact-actions">
          <a class="external-link" href={site.github} target="_blank" rel="noreferrer"><Localized en="GitHub" zh="GitHub" /> <span aria-hidden="true">↗</span></a>
          <a class="external-link" href={`${base}${site.resumePath}`}><Localized en="Download résumé" zh="下载简历" /> <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="education page-width" aria-labelledby="education-title">
    <p class="eyebrow"><Localized en="Education" zh="教育" /></p>
    <h2 id="education-title"><Localized en="Background" zh="教育背景" /></h2>
    <div class="education-list">
      <article class="education-entry">
        <h3><Localized en="National University of Singapore" zh="新加坡国立大学" /></h3>
        <p class="edu-line"><Localized en="M.S. in Computer Science (General Track) · Jan 2025–present" zh="计算机硕士（通用分支）｜2025.01—至今" /></p>
        <p class="edu-line"><Localized en="AI4SG Lab · human–computer interaction, human–AI collaboration, and generative-AI creation" zh="AI4SG Lab｜人机交互、人机协作与生成式 AI 创作" /></p>
      </article>
      <article class="education-entry">
        <h3><Localized en="Peking University" zh="北京大学" /></h3>
        <p class="edu-line"><Localized en="B.A. in Russian Language and Literature · Sep 2020–Jul 2024" zh="俄语语言文学学士｜2020.09—2024.07" /></p>
        <p class="edu-line"><Localized en="Major rank 2 · Peking University Social Work Award (2021)" zh="专业第二｜北京大学社会工作奖（2021）" /></p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 650;
    letter-spacing: .075em;
    text-transform: uppercase;
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: var(--space-section) 0;
  }
  h1, h2, p { margin-top: 0; }
  h1, h2 {
    margin-bottom: 0;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: .98;
    letter-spacing: var(--display-tracking);
  }
  .about-copy { max-width: 530px; }
  .about-copy p {
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .about-copy p + p { color: var(--muted); }
  .contact-block { margin-top: 1.75rem; }
  .email-list { display: grid; gap: 1.1rem; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
  .education {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--rule-strong);
  }
  .education .eyebrow { margin-bottom: 1.5rem; }
  .education h2 { margin-bottom: 1.5rem; }
  .education-list { display: grid; gap: 2.5rem; }
  .education-entry h3 { margin: 0 0 .7rem; font-size: 1.35rem; letter-spacing: -.01em; }
  .education-entry .edu-line { margin: 0 0 .35rem; max-width: 560px; color: var(--muted); font-size: 1.1rem; }
  :global(:root[data-locale='zh']) h1,
  :global(:root[data-locale='zh']) h2 {
    font-size: clamp(2.1rem, 4.2vw, 3.75rem);
    line-height: 1.2;
    letter-spacing: -.04em;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .about, .education { padding: 5rem 0; }
  }
  @media (max-width: 560px) {
    :global(:root[data-locale='zh']) h1,
    :global(:root[data-locale='zh']) h2 {
      font-size: clamp(2rem, 8vw, 2.8rem);
    }
  }
</style>
